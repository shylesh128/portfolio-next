# MongoDB (server-side only; never prefix this with NEXT_PUBLIC_)
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/portfolio

# Required for privacy-safe visitor hashing. Generate a random secret of 32+ characters.
ANALYTICS_HASH_SECRET=replace-with-a-long-random-secret

# Protects /admin/analytics and /api/analytics/summary with HTTP Basic authentication.
ANALYTICS_DASHBOARD_USER=admin
ANALYTICS_DASHBOARD_PASSWORD=replace-with-a-strong-password

# Optional. MongoDB TTL indexes remove analytics events and sessions after this many days.
ANALYTICS_RETENTION_DAYS=180

# Existing contact-form email delivery settings.
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=your-gmail-app-password
CONTACT_EMAIL=you@example.com
